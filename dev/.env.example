# Configuration is server-side. dev/start prompts for admin password on first use.
# Optional: put a Lambda Cloud API key in dev/.secrets/lambda_api_key.
# Local database is bound to loopback only; its development credentials are not production credentials.
MANAGEMENT_DATABASE_URL=postgresql+psycopg://management:management@localhost:55432/management
MANAGEMENT_ADMIN_PASSWORD_FILE=dev/.secrets/admin_password
MANAGEMENT_LAMBDA_API_KEY_FILE=dev/.secrets/lambda_api_key
MANAGEMENT_ALLOWED_ORIGIN=http://localhost:5173
MANAGEMENT_SECURE_COOKIES=false
