{
  "uid": "klip-telemetry",
  "title": "KLIP / Telemetry delivery and storage health",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "tags": [
    "klip",
    "provisioned",
    "cpu-foundation"
  ],
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Scope and interpretation",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Thanos deduplicates Prometheus replicas; partial query responses are disabled. Missing series remain No data. Queue units and actual Collector metric names must be checked against the installed binary before telemetry delivery acceptance. This view is not proof of object retention or lossless delivery."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Targets down by job",
      "datasource": {
        "type": "prometheus",
        "uid": "klip-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(job)(1-up)",
          "legendFormat": "{{instance}} {{namespace}} {{pod}} {{job}} {{exporter}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
