{
  "uid": "klip-a10-speculation",
  "title": "KLIP / A10 WriterAssist speculation",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "tags": [
    "klip",
    "provisioned",
    "retained-a10"
