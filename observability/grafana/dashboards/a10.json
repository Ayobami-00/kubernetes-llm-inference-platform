  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Experiment boundaries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "Retained single A10, Qwen3-4B, private API-key authenticated llm-d. Baseline and n-gram variants use separate frozen run identities. Server histograms are diagnostics: authoritative **client completion, fixed-window SLO, delivery validity and JFLEG GLEU** are in management run reports. Non-streaming client requests do not provide client TTFT. No data stays No data; baseline has no speculation counters. GPU/server availability is not serving HA. Scraping started after the first baseline began; retained run records cover its full timeline."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Serving scrape health",
      "datasource": {
        "type": "prometheus",
        "uid": "klip-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{namespace=\"llm-d\"}",
          "legendFormat": "{{pod}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
