{
  "uid": "klip-cluster",
  "title": "KLIP / Cluster and host diagnostics",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "tags": [
    "klip",
    "provisioned",
    "cpu-foundation"
  ],
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Scope and interpretation",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Node exporter reads host CPU/memory/filesystems. Its Pod-network counters are disabled. WireGuard, Cilium/Hubble, authenticated etcd and private scheduler/controller metrics are pending; no network or etcd health is inferred from absent data."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Host CPU utilization",
      "datasource": {
        "type": "prometheus",
        "uid": "klip-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1-avg by(instance)(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
          "legendFormat": "{{instance}} {{namespace}} {{pod}} {{job}} {{exporter}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Host memory utilization",
      "datasource": {
        "type": "prometheus",
        "uid": "klip-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1-node_memory_MemAvailable_bytes/node_memory_MemTotal_bytes",
          "legendFormat": "{{instance}} {{namespace}} {{pod}} {{job}} {{exporter}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Host filesystem available",
      "datasource": {
        "type": "prometheus",
        "uid": "klip-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\"}",
          "legendFormat": "{{instance}} {{namespace}} {{pod}} {{job}} {{exporter}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Container CPU throttling",
      "datasource": {
        "type": "prometheus",
        "uid": "klip-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace,pod)(rate(container_cpu_cfs_throttled_periods_total{namespace!=\"\"}[5m]))/sum by(namespace,pod)(rate(container_cpu_cfs_periods_total{namespace!=\"\"}[5m]))",
          "legendFormat": "{{instance}} {{namespace}} {{pod}} {{job}} {{exporter}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Container restarts",
      "datasource": {
        "type": "prometheus",
        "uid": "klip-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace,pod)(increase(kube_pod_container_status_restarts_total[15m]))",
          "legendFormat": "{{instance}} {{namespace}} {{pod}} {{job}} {{exporter}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Kubernetes API request rate",
      "datasource": {
        "type": "prometheus",
        "uid": "klip-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(verb,code)(rate(apiserver_request_total[5m]))",
          "legendFormat": "{{instance}} {{namespace}} {{pod}} {{job}} {{exporter}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "links": []
}
