{
  "uid": "klip-platform",
  "title": "KLIP / Platform overview",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "tags": [
    "klip",
    "provisioned",
    "cpu-foundation"
  ],
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Scope and interpretation",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "This view covers the CPU foundation. GPU/model/gateway/customer delivery sources are added only after their pinned exporters and authoritative records are integrated. Pod Ready is not GPU or serving readiness."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Ready Kubernetes nodes",
      "datasource": {
        "type": "prometheus",
        "uid": "klip-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})",
          "legendFormat": "{{instance}} {{namespace}} {{pod}} {{job}} {{exporter}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Unready application Pods",
      "datasource": {
        "type": "prometheus",
        "uid": "klip-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(1-kube_pod_status_ready{condition=\"true\",namespace=~\"klip|platform-data|observability\"})",
          "legendFormat": "{{instance}} {{namespace}} {{pod}} {{job}} {{exporter}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Scrape targets down",
      "datasource": {
        "type": "prometheus",
        "uid": "klip-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(1-up)",
          "legendFormat": "{{instance}} {{namespace}} {{pod}} {{job}} {{exporter}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Firing alerts",
      "datasource": {
        "type": "prometheus",
        "uid": "klip-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ALERTS{alertstate=\"firing\",alertname!=\"Watchdog\"})",
          "legendFormat": "{{instance}} {{namespace}} {{pod}} {{job}} {{exporter}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Platform CPU requests",
      "datasource": {
        "type": "prometheus",
        "uid": "klip-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_container_resource_requests{resource=\"cpu\",node=~\"platform-.*\"})",
          "legendFormat": "{{instance}} {{namespace}} {{pod}} {{job}} {{exporter}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Platform memory requests",
      "datasource": {
        "type": "prometheus",
        "uid": "klip-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_container_resource_requests{resource=\"memory\",node=~\"platform-.*\"})",
          "legendFormat": "{{instance}} {{namespace}} {{pod}} {{job}} {{exporter}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "links": []
}
