{
  "uid": "klip-network",
  "title": "KLIP / Host mesh and network diagnostics",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "tags": [
    "klip",
    "provisioned",
    "cpu-foundation"
  ],
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Scope and interpretation",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Read-only host observations use logical peer identities, never keys. The six-host full mesh currently has thirty directed peer records. A handshake timestamp of zero means no handshake; old handshakes on idle links are not sufficient evidence of an outage. Observer failure or missing series is not a healthy mesh. Cilium/Hubble flow, drop, DNS and path-MTU measurements remain pending."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "WireGuard observation success",
      "datasource": {
        "type": "prometheus",
        "uid": "klip-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "klip_wireguard_observation_success",
          "legendFormat": "{{instance}} {{namespace}} {{pod}} {{job}} {{exporter}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
