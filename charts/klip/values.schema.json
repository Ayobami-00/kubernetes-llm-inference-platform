{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicas": {
      "type": "object",
      "properties": {
        "api": {"type": "integer", "minimum": 1},
        "worker": {"type": "integer", "minimum": 1},
        "web": {"type": "integer", "minimum": 1}
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {"type": "integer", "minimum": 1},
        "spreadAcrossZones": {"type": "boolean"}
      },
      "required": ["enabled", "minAvailable", "spreadAcrossZones"]
    },
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 30},
    "imagePullRoleArn": {"type": "string", "pattern": "^$|^arn:aws:iam::[0-9]{12}:role/[A-Za-z0-9_+=,.@/-]+$"},
    "web": {
      "type": "object",
      "properties": {
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "existingSecret": {"type": "string", "minLength": 1},
            "createCertificate": {"type": "boolean"},
            "dnsNames": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
          },
          "required": ["enabled", "existingSecret", "createCertificate", "dnsNames"]
        }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "requireTLS": {"type": "boolean"},
        "caSecret": {"type": "string"},
        "caKey": {"type": "string", "minLength": 1}
      }
    }
  }
}
