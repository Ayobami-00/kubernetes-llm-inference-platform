      "required": [
        "unit",
        "rate"
      ],
      "title": "Arrival",
      "type": "object"
    },
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
