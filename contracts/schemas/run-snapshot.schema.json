    "CustomerSpec": {
      "additionalProperties": false,
      "properties": {
        "generation": {
          "$ref": "#/$defs/Generation"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "limits": {
          "$ref": "#/$defs/CustomerLimits"
        },
        "model_alias": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
