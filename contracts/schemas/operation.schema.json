{
  "$defs": {
    "ErrorInfo": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "ExecutionStatus": {
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "OperationTarget": {
      "additionalProperties": false,
      "properties": {
        "requested_revision": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Revision"
        },
        "resource_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Resource Id",
          "type": "string"
        },
        "resource_type": {
          "enum": [
            "worker_group",
            "serving_deployment",
            "run",
            "experiment"
          ],
          "title": "Resource Type",
          "type": "string"
        }
      },
      "required": [
        "resource_type",
        "resource_id"
      ],
      "title": "OperationTarget",
      "type": "object"
    }
  },
  "$id": "https://schemas.inference-platform.example/0.1/operation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cleanup_pending": {
      "default": false,
      "title": "Cleanup Pending",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "current_step": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Step"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "fixture": {
      "default": false,
      "title": "Fixture",
      "type": "boolean"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/ExecutionStatus"
    },
    "target": {
      "$ref": "#/$defs/OperationTarget"
    },
    "type": {
      "enum": [
        "create_worker_group",
        "delete_worker_group",
        "renew_worker_group",
        "deploy_serving",
        "start_run",
        "stop_run",
        "start_experiment",
        "stop_experiment"
      ],
      "title": "Type",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "target",
    "status",
    "created_at",
    "updated_at"
  ],
  "title": "OperationStatus",
  "type": "object"
}
