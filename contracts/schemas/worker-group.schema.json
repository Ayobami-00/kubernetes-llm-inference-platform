{
  "$defs": {
    "ErrorInfo": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "GPUCapacityObservation": {
      "additionalProperties": false,
      "description": "Observed usable memory, distinct from the provider's advertised hardware.",
      "properties": {
        "allocatable_gpu_count": {
          "minimum": 0,
          "title": "Allocatable Gpu Count",
          "type": "integer"
        },
        "devices": {
          "items": {
            "$ref": "#/$defs/GPUDeviceObservation"
          },
          "minItems": 1,
          "title": "Devices",
          "type": "array"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "observed_at",
        "devices",
        "allocatable_gpu_count"
      ],
      "title": "GPUCapacityObservation",
      "type": "object"
    },
    "GPUDeviceObservation": {
      "additionalProperties": false,
      "properties": {
        "driver_version": {
          "minLength": 1,
          "title": "Driver Version",
          "type": "string"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "memory_total_mib": {
          "exclusiveMinimum": 0,
          "title": "Memory Total Mib",
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "uuid": {
          "pattern": "^GPU-[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$",
          "title": "Uuid",
          "type": "string"
        }
      },
      "required": [
        "index",
        "uuid",
        "name",
        "memory_total_mib",
        "driver_version"
      ],
      "title": "GPUDeviceObservation",
      "type": "object"
    },
    "GPUHardware": {
      "additionalProperties": false,
      "properties": {
        "gpu_count": {
          "exclusiveMinimum": 0,
          "title": "Gpu Count",
          "type": "integer"
        },
        "gpu_model": {
          "minLength": 1,
          "title": "Gpu Model",
          "type": "string"
        },
        "vendor": {
          "const": "nvidia",
          "default": "nvidia",
          "title": "Vendor",
          "type": "string"
        },
        "vram_gib_per_gpu": {
          "exclusiveMinimum": 0,
          "title": "Vram Gib Per Gpu",
          "type": "number"
        }
      },
      "required": [
        "gpu_model",
        "gpu_count",
        "vram_gib_per_gpu"
      ],
      "title": "GPUHardware",
      "type": "object"
    },
    "WorkerCounts": {
      "additionalProperties": false,
      "properties": {
        "allocated_instances": {
          "minimum": 0,
          "title": "Allocated Instances",
          "type": "integer"
        },
        "desired_instances": {
          "minimum": 0,
          "title": "Desired Instances",
          "type": "integer"
        },
        "gpu_ready_nodes": {
          "minimum": 0,
          "title": "Gpu Ready Nodes",
          "type": "integer"
        },
        "joined_nodes": {
          "minimum": 0,
          "title": "Joined Nodes",
          "type": "integer"
        }
      },
      "required": [
        "desired_instances",
        "allocated_instances",
        "joined_nodes",
        "gpu_ready_nodes"
      ],
      "title": "WorkerCounts",
      "type": "object"
    },
    "WorkerGroupSpec": {
      "additionalProperties": false,
      "properties": {
        "capacity_lifecycle": {
          "default": "leased",
          "enum": [
            "leased",
            "externally_retained"
          ],
          "title": "Capacity Lifecycle",
          "type": "string"
        },
        "desired_instances": {
          "default": 1,
          "minimum": 0,
          "title": "Desired Instances",
          "type": "integer"
        },
        "drain_timeout_s": {
          "default": 120,
          "exclusiveMinimum": 0,
          "title": "Drain Timeout S",
          "type": "integer"
        },
        "hardware": {
          "$ref": "#/$defs/GPUHardware"
        },
        "host_profile": {
          "default": "lambda-gpu-worker-v1",
          "minLength": 1,
          "title": "Host Profile",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "instance_type": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instance Type"
        },
        "notes": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "provider": {
          "const": "lambda",
          "default": "lambda",
          "title": "Provider",
          "type": "string"
        },
        "region": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "revision": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "ttl_minutes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 90,
          "title": "Ttl Minutes"
        },
        "worker_class": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Worker Class",
          "type": "string"
        }
      },
      "required": [
        "id",
        "hardware",
        "worker_class"
      ],
      "title": "WorkerGroupSpec",
      "type": "object"
    },
    "WorkerGroupStatus": {
      "additionalProperties": false,
      "properties": {
        "active_operation_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Operation Id"
        },
        "allocated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allocated At"
        },
        "capacity_lifecycle": {
          "default": "leased",
          "enum": [
            "leased",
            "externally_retained"
          ],
          "title": "Capacity Lifecycle",
          "type": "string"
        },
        "counts": {
          "$ref": "#/$defs/WorkerCounts"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "members": {
          "default": [],
          "items": {
            "$ref": "#/$defs/WorkerMember"
          },
          "title": "Members",
          "type": "array"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "phase": {
          "enum": [
            "allocating",
            "joining",
            "ready",
            "partial_failure",
            "draining",
            "expired",
            "deleted",
            "failed"
          ],
          "title": "Phase",
          "type": "string"
        },
        "worker_group_ref": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*@[1-9][0-9]*$",
          "title": "Worker Group Ref",
          "type": "string"
        }
      },
      "required": [
        "worker_group_ref",
        "phase",
        "counts",
        "observed_at"
      ],
      "title": "WorkerGroupStatus",
      "type": "object"
    },
    "WorkerMember": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gpu_observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/GPUCapacityObservation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "node_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Name"
        },
        "node_uid": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Uid"
        },
        "phase": {
          "enum": [
            "allocated",
            "configuring",
            "joining",
            "gpu_ready",
            "failed",
            "terminated"
          ],
          "title": "Phase",
          "type": "string"
        },
        "provider_instance_id": {
          "minLength": 1,
          "title": "Provider Instance Id",
          "type": "string"
        }
      },
      "required": [
        "provider_instance_id",
        "phase"
      ],
      "title": "WorkerMember",
      "type": "object"
    }
  },
  "$id": "https://schemas.inference-platform.example/0.1/worker-group.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "fixture": {
      "default": false,
      "title": "Fixture",
      "type": "boolean"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "spec": {
      "$ref": "#/$defs/WorkerGroupSpec"
    },
    "status": {
      "$ref": "#/$defs/WorkerGroupStatus"
    }
  },
  "required": [
    "spec",
    "status"
  ],
  "title": "WorkerGroup",
  "type": "object"
}
